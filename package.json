{
  "name": "timemap",
  "version": "0.1.0",
  "description": "TimeMap with Vite and Cowrie Honeypot module",
  "homepage": ".",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "dependencies": {
    "d3": "^7.4.2",
    "dayjs": "^1.11.0",
    "joi": "^14.0.1",
    "leaflet": "^1.0.3",
    "marked": "^4.0.10",
    "object-hash": "^1.3.0",
    "ramda": "^0.32.0",
    "react": "^18.0.0",
    "react-device-detect": "^1.6.2",
    "react-dom": "^18.0.0",
    "react-image": "^1.5.1",
    "react-portal": "^4.2.0",
    "react-redux": "7.2.8",
    "react-tabs": "3.0.0",
    "react-twitter-embed": "^4.0.4",
    "redux": "4.1.2",
    "redux-thunk": "2.4.1",
    "reselect": "^3.0.1",
    "screenfull": "^5.2.0",
    "supercluster": "^7.1.5",
    "video-react": "^0.13.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@vitejs/plugin-react": "^4.3.1",
    "husky": "^4.3.5",
    "jsdom": "^24.1.1",
    "lint-staged": "^10.5.3",
    "prettier": "^2.2.1",
    "sass": "^1.77.8",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
